{% extends "layouts/base.twig" %}

{% block content %}
<div class="container mx-auto px-4 py-8">
    <h1 class="text-4xl font-bold mb-6">Posts</h1>
    {% if posts|length > 0 %}
        {% for post in posts %}
        <article class="mb-6 p-4 border rounded">
            <h2 class="text-2xl font-semibold">{{ post.title }}</h2>
            <p class="text-gray-600 mt-2">{{ post.body|slice(0, 120) }}...</p>
            <a href="/posts/show?id={{ post.id }}" class="text-blue-500 mt-2 inline-block">Read more &rarr;</a>
        </article>
        {% endfor %}
    {% else %}
        <p class="text-gray-500">No posts yet.</p>
    {% endif %}
</div>
{% endblock %}
